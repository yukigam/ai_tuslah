# Solana RPC (use a private RPC for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=https://solana-rpc.publicnode.com

# Wallet (base58 private key) - NEVER commit
WALLET_PRIVATE_KEY=

# Jito
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000
JITO_ENABLED=true

# Priority fees
PRIORITY_FEE_PERCENTILE=75
MAX_PRIORITY_FEE_LAMPORTS=1000000

# Risk management
PAPER_MODE=true
LIVE_MODE=false
MAX_POSITION_SOL=0.5
MAX_SLIPPAGE_PERCENT=10
TAKE_PROFIT_PERCENT=50
STOP_LOSS_PERCENT=20
TRAILING_STOP_PERCENT=10
DAILY_LOSS_LIMIT_SOL=2

# Copy trading
COPY_WALLETS=
COPY_AMOUNT_SOL=0.1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Axiom webhook
AXIOM_WEBHOOK_PORT=8080
AXIOM_WEBHOOK_SECRET=

# DB
DB_PATH=./data/positions.db
